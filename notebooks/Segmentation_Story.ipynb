{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Superstore Customer Segmentation — Project Story\n",
    "\n",
    "This notebook walks through an end-to-end segmentation workflow:\n",
    "- Data loading and cleaning\n",
    "- Exploratory Data Analysis (EDA)\n",
    "- Feature engineering for behavior\n",
    "- Clustering (KMeans and DBSCAN)\n",
    "- Model selection via Elbow and Silhouette\n",
    "- Cluster profiling and marketing insights"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Setup\n",
    "%load_ext autoreload\n",
    "%autoreload 2\n",
    "import os, sys, pandas as pd, numpy as np, seaborn as sns, matplotlib.pyplot as plt\n",
    "plt.style.use('seaborn-v0_8')\n",
    "sys.path.append(os.path.join('..','src'))\n",
    "from clustering import (basic_clean, engineer_behavior_features, build_feature_matrix, \
",
    "    scale_and_project, elbow_scores, silhouette_scores_k, fit_kmeans, fit_dbscan, profile_clusters)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data_path = os.path.join('..','data','train.csv')\n",
    "df = pd.read_csv(data_path)\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Cleaning and Quick EDA"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df_clean = basic_clean(df)\n",
    "df_clean.describe(include='all').T.head(20)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Example distributions\n",
    "num_cols = df_clean.select_dtypes(include=[np.number]).columns[:6]\n",
    "sns.pairplot(df_clean[num_cols].dropna());"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Feature Engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df_fe = engineer_behavior_features(df_clean)\n",
    "X, feats = build_feature_matrix(df_fe, include_categorical=False)\n",
    "X.shape, len(feats)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Scale and PCA"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "Xs, scaler, pca_model = scale_and_project(X, n_components=2)\n",
    "# PCA scatter for quick look\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.cm import get_cmap\n",
    "fig, ax = plt.subplots(figsize=(5,4))\n",
    "pc = pca_model.transform(Xs) if pca_model else None\n",
    "if pc is not None:\n",
    "    ax.scatter(pc[:,0], pc[:,1], s=10, alpha=0.6)\n",
    "    ax.set_title('PCA (unlabeled)')\n",
    "    ax.set_xlabel('PC1'); ax.set_ylabel('PC2')\n",
    "fig.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. KMeans — Elbow and Silhouette"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "elbow = elbow_scores(Xs, 2, 12)\n",
    "sil = silhouette_scores_k(Xs, list(range(2,13)))\n",
    "fig, axes = plt.subplots(1,2, figsize=(10,4))\n",
    "axes[0].plot(elbow['k'], elbow['inertia'], marker='o'); axes[0].set_title('Elbow'); axes[0].set_xlabel('k'); axes[0].set_ylabel('Inertia')\n",
    "axes[1].plot(sil['k'], sil['silhouette'], marker='o'); axes[1].set_title('Silhouette'); axes[1].set_xlabel('k'); axes[1].set_ylabel('Score')\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Fit Clusters and Profile"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "k = 4\n",
    "res = fit_kmeans(Xs, k=k, pca_model=pca_model, scaler=scaler)\n",
    "labels = res.labels\n",
    "summary, labeled = profile_clusters(df_fe, Xs, labels)\n",
    "summary.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize clusters in PCA space\n",
    "fig, ax = plt.subplots(figsize=(5,4))\n",
    "pc = res.pca_components\n",
    "sc = ax.scatter(pc[:,0], pc[:,1], c=labels, cmap='tab10', s=12, alpha=0.8)\n",
    "plt.colorbar(sc, ax=ax, label='Cluster'); ax.set_title('KMeans Clusters (PCA)'); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. DBSCAN Alternative"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "res_db = fit_dbscan(Xs, eps=0.8, min_samples=10, pca_model=pca_model, scaler=scaler)\n",
    "np.unique(res_db.labels, return_counts=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Marketing Insights\n",
    "Describe each segment in terms of spend, frequency, engagement, and demographics to craft targeted actions (e.g., upsell Premium to High-Value Bingers; win-back offers to Low-Engagement, High-Price-Sensitivity)."
   ]
  }
 ],
